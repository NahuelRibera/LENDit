<% content_for :title, "My Lends — LENDit" %>

<div class="container section">
  <h1 class="section__title">My Lends</h1>

  <div class="status-tabs">
    <% Account::LendsController::STATUS_TABS.each do |status| %>
      <%= link_to account_lends_path(status: status), class: "status-tabs__tab #{"is-active" if @status == status}" do %>
        <%= status.capitalize %>
        <% if @counts[status].to_i > 0 %><span class="status-tabs__count"><%= @counts[status] %></span><% end %>
      <% end %>
    <% end %>
  </div>

  <% if @rentals.any? %>
    <div class="rental-rows">
      <% @rentals.each do |rental| %>
        <%= render "shared/rental_row", rental: rental, role: :lender %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
          icon_name: "image",
          title: "No #{@status} lends",
          description: "Requests to borrow your items will show up here." %>
  <% end %>
</div>
