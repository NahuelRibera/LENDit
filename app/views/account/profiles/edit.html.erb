<% content_for :title, "Account settings — LENDit" %>

<div class="container section">
  <div class="settings-layout">
    <div>
      <h1 class="section__title">Account settings</h1>
      <p class="settings-intro">Update your profile, photo, and password.</p>

      <%= render "shared/form_errors", object: @user %>

      <%= form_with model: @user, url: account_profile_path, method: :patch, multipart: true, class: "settings-form" do |f| %>
        <div class="settings-form__avatar-row">
          <%= render "shared/avatar",
                name: @user.full_name,
                image_url: (@user.avatar.attached? ? url_for(@user.avatar.variant(resize_to_fill: [96, 96])) : nil),
                size: :lg %>
          <div class="field settings-form__avatar-field">
            <%= f.label :avatar, "Profile photo", class: "field__label" %>
            <%= f.file_field :avatar, class: "input", accept: "image/png,image/jpeg,image/webp" %>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <%= f.label :first_name, class: "field__label" %>
            <%= f.text_field :first_name, class: "input", required: true %>
          </div>
          <div class="field">
            <%= f.label :last_name, class: "field__label" %>
            <%= f.text_field :last_name, class: "input", required: true %>
          </div>
        </div>

        <div class="field">
          <%= f.label :city, class: "field__label" %>
          <%= f.text_field :city, class: "input" %>
        </div>

        <div class="field">
          <%= f.label :bio, class: "field__label" %>
          <span class="field__help">Shown on your public profile</span>
          <%= f.text_area :bio, class: "textarea", maxlength: 500 %>
        </div>

        <hr class="settings-form__divider">

        <p class="settings-form__section-title">Change password</p>
        <p class="field__help">Leave blank to keep your current password.</p>

        <div class="field-row">
          <div class="field">
            <%= f.label :password, "New password", class: "field__label" %>
            <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
          </div>
          <div class="field">
            <%= f.label :password_confirmation, "Confirm new password", class: "field__label" %>
            <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
          </div>
        </div>

        <%= f.submit "Save changes", class: "btn btn--primary" %>
      <% end %>
    </div>

    <aside class="settings-sidebar">
      <%= render "shared/avatar",
            name: @user.full_name,
            image_url: (@user.avatar.attached? ? url_for(@user.avatar.variant(resize_to_fill: [96, 96])) : nil),
            size: :lg %>
      <p class="settings-sidebar__name"><%= @user.full_name %></p>
      <%= render "shared/rating", rating: @user.ratings_avg, reviews_count: @user.ratings_count, size: :sm %>
      <%= link_to "View public profile", user_path(@user), class: "btn btn--secondary btn--sm settings-sidebar__link" %>
    </aside>
  </div>
</div>
