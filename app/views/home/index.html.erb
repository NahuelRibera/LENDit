<% content_for :title, "LENDit — Borrow what you need, lend what you don't" %>

<section class="hero-section">
  <div class="container">
    <div class="hero" style="background-image: url('<%= asset_path("hero-background.jpg") %>')">
      <div class="hero__media-overlay" aria-hidden="true"></div>
      <div class="hero__copy">
        <h1 class="hero__heading">
          <span class="hero__heading-line">Borrow what you need.</span>
          <span class="hero__heading-line">Lend what you don't.</span>
        </h1>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Explore by category</h2>
    </div>
    <div class="grid-categories">
      <% nav_categories.each do |category| %>
        <%= link_to category_path(category.slug), class: "category-tile" do %>
          <span class="category-tile__icon"><%= icon(category.icon_key, size: 22) %></span>
          <span class="category-tile__name"><%= category.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="section section--muted">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Recently added</h2>
      <%= link_to listings_path, class: "section__link" do %>
        Browse all
        <%= icon("chevron-right", size: 14) %>
      <% end %>
    </div>
    <% if @recent_listings.any? %>
      <div class="grid-cards">
        <% @recent_listings.each do |listing| %>
          <%= render "shared/listing_card", listing: listing %>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state",
            icon_name: "image",
            title: "No listings yet",
            description: "Be the first to list something in the marketplace.",
            action_text: (signed_in? ? "List an item" : nil),
            action_href: (signed_in? ? new_listing_path : nil) %>
    <% end %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Recently viewed</h2>
    </div>
    <% if @recently_viewed_listings.any? %>
      <div class="grid-cards">
        <% @recently_viewed_listings.each do |listing| %>
          <%= render "shared/listing_card", listing: listing %>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state",
            icon_name: "image",
            title: "You haven't viewed anything yet",
            description: "Items you look at will show up here so you can find them again.",
            action_text: "Start exploring",
            action_href: listings_path %>
    <% end %>
  </div>
</section>
