<%# locals: (icon_name: "image", title:, description: nil, action_text: nil, action_href: nil) %>
<div class="empty-state">
  <div class="empty-state__icon"><%= icon(icon_name, size: 28) %></div>
  <p class="empty-state__title"><%= title %></p>
  <% if description %>
    <p class="empty-state__description"><%= description %></p>
  <% end %>
  <% if action_text.present? && action_href.present? %>
    <%= link_to action_text, action_href, class: "btn btn--secondary empty-state__action" %>
  <% end %>
</div>
