<% content_for :title, "Sign up — LENDit" %>

<div class="container auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Create your account</h1>
    <p class="auth-card__subtitle">Start borrowing and lending in your city.</p>

    <%= render "shared/form_errors", object: @user %>

    <%= form_with model: @user, url: registration_path do |f| %>
      <div class="field">
        <%= f.label :first_name, class: "field__label" %>
        <%= f.text_field :first_name, class: "input", required: true, autofocus: true %>
      </div>

      <div class="field">
        <%= f.label :last_name, class: "field__label" %>
        <%= f.text_field :last_name, class: "input", required: true %>
      </div>

      <div class="field">
        <%= f.label :email, class: "field__label" %>
        <%= f.email_field :email, class: "input", required: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :city, class: "field__label" %>
        <span class="field__help">So people can find items near them</span>
        <%= f.text_field :city, class: "input" %>
      </div>

      <div class="field">
        <%= f.label :password, class: "field__label" %>
        <span class="field__help">At least 8 characters</span>
        <%= f.password_field :password, class: "input", required: true, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirm password", class: "field__label" %>
        <%= f.password_field :password_confirmation, class: "input", required: true, autocomplete: "new-password" %>
      </div>

      <%= f.submit "Create account", class: "btn btn--primary btn--block" %>
    <% end %>

    <p class="auth-card__footer">
      Already have an account? <%= link_to "Log in", new_session_path %>
    </p>
  </div>
</div>
